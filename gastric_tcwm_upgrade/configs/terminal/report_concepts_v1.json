    "gradient_clip": 1.0,
    "max_optimizer_steps": 500,
    "validation_interval": 50,
    "checkpoint_interval": 10,
    "minimum_optimizer_steps": 100,
    "patience": 5,
    "forecast_weight": 0.1,
    "pcr_weight": 0.1,
    "alignment_weight": 0.1,
    "report_concept_weight": 0.0,
    "assimilation_weight": 0.0,
    "drift_weight": 0.0001,
    "device": "cuda"
  }
}
