{
  "model": {
    "objective": "terminal_state_v1",
    "s1_report_concepts": true,
    "hidden": 128,
    "image_dim": 768,
    "time_basis": "ordinal_stage",
    "ablation": "dynamic",
    "assimilate_ct1": false
  },
  "training": {
    "seed": 17,
    "batch_size": 8,
    "accumulation_steps": 2,
