{
  "model": {
    "architecture": "modality_timeline_v2",
    "schema": "modality-event-v2",
    "capacity_profile": "compact_v1",
    "image_dim": 768,
    "clinical_dim": 32,
    "hidden": 64,
    "init_blocks": 1,
    "field_blocks": 1,
    "history_blocks": 1,
    "event_blocks": 1,
    "drift_blocks": 1,
    "observation_blocks": 1,
    "readout_blocks": 1,
    "dropout": 0.3,
    "time_basis": "ordinal_stage",
    "ablation": "dynamic",
    "objective": "terminal_state_v1",
    "terminal_clinical_anchor": false,
    "terminal_residual_scale": 0.25,
    "clinical_normalization": "continuous_only",
    "s1_report_concepts": false,
    "assimilate_ct1": false,
    "ode_step_days": 1.0,
    "schema_enabled": [true, false, true, true, true, true, true]
  },
  "training": {
    "seed": 17,
    "batch_size": 8,
    "accumulation_steps": 2,
    "learning_rate": 0.00005,
    "image_learning_rate": 0.00001,
    "weight_decay": 0.05,
    "gradient_clip": 1.0,
    "max_optimizer_steps": 300,
    "validation_interval": 10,
    "checkpoint_interval": 10,
    "minimum_optimizer_steps": 100,
    "patience": 8,
    "min_delta": 0.00001,
    "forecast_weight": 0.01,
    "pcr_weight": 0.1,
    "alignment_weight": 0.0,
    "report_concept_weight": 0.0,
    "assimilation_weight": 0.0,
    "drift_weight": 0.0,
    "evaluate_test": false,
    "validate_initial": true,
    "freeze_image_projection": false,
    "collect_full_train_metrics": true,
    "device": "cuda"
  }
}
